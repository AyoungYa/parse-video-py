# ---------------------------------------------------------------------------
# 无痕匠 · 云端服务环境变量
# 复制为 .env 后按实际填写。千万不要把 .env 提交进 git。
# ---------------------------------------------------------------------------

DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=请换成一串随机 50 位字符
DEBUG=0
ALLOWED_HOSTS=wuhenjiang.com,www.wuhenjiang.com
CSRF_TRUSTED_ORIGINS=https://wuhenjiang.com,https://www.wuhenjiang.com
CORS_ALLOWED_ORIGINS=https://wuhenjiang.com

# ---- MySQL 8（远程实例；本地开发也连它，本项目不用 SQLite）----
# 填远程实例的公网/内网地址。云上部署时若与应用同机，可写 127.0.0.1。
MYSQL_HOST=mysql.example.com
MYSQL_PORT=3306
MYSQL_NAME=wuhenjiang
MYSQL_USER=wuhenjiang
MYSQL_PASSWORD=强密码
# 远程连接必须设超时，否则网络抖动会让请求线程一直挂着（长轮询会瞬间吃满 worker）
MYSQL_CONNECT_TIMEOUT=10
MYSQL_READ_TIMEOUT=30
MYSQL_WRITE_TIMEOUT=30
MYSQL_CONN_MAX_AGE=60
# 走公网就开 TLS：MYSQL_SSL=1 加密；再给 MYSQL_SSL_CA 才校验证书（自签证书可留空）
MYSQL_SSL=1
MYSQL_SSL_CA=

# 云端 MySQL 测试专用账号和独立库；不要使用业务库账号。
TEST_MYSQL_HOST=
TEST_MYSQL_PORT=3306
TEST_MYSQL_NAME=test_wuhenjiang
TEST_MYSQL_USER=
TEST_MYSQL_PASSWORD=
TEST_MYSQL_SSL=1
TEST_MYSQL_SSL_CA=

# ---- 阿里云 OSS（AK/SK 只放在这里，绝不发给算力机）----
# ★ OSS_ENDPOINT 必须是**公网** endpoint，且与 Bucket 所在地域一致：
#   - 写错地域 → OSS 回 301/AccessDenied（提示 must be addressed using the specified endpoint）
#   - 写 -internal.aliyuncs.com → 浏览器直传会失败（内网地址公网访问不到）
#   - 不写协议也行，代码内部统一按 https 处理（oss2 自己会补 http://，那样浏览器会按混合内容拦截）
OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
OSS_BUCKET=wuhenjiang-temp
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_UPLOAD_PREFIX=uploads/
OSS_RESULT_PREFIX=results/
OSS_SIGN_EXPIRE_SECONDS=900
OSS_MAX_UPLOAD_BYTES=524288000
# 素材保留天数（任务结束后自动清理），单位：天
OSS_RETENTION_DAYS=3

# ---- 任务与租约（必须和 gpu_worker 的对应值一致）----
WORKER_CLAIM_TIMEOUT=25
LEASE_SECONDS=90
HEARTBEAT_INTERVAL=15
MAX_ATTEMPT=3
STALE_UPLOAD_MINUTES=30

# ---- 付费规则（数值来自成本模型，改前先看 docs/product/成本与选型.md）----
INITIAL_GIFT_POINTS=100
FREE_TRIAL_MAX_SECONDS=30
SIGN_IN_POINTS=1
SIGN_IN_STREAK_BONUS=5
MONTHLY_MINUTES_LIMIT=100

# ---- 短信验证码登录 ----
# console = 不真发（只打日志，开发用）；dypnsapi = 阿里云号码认证短信服务
SMS_PROVIDER=dypnsapi
# 生产必须为 0。1 会把验证码直接回显给前端，等于谁都能登录。
SMS_DEV_ECHO=0
SMS_CODE_TTL_SECONDS=300
SMS_RESEND_INTERVAL_SECONDS=60
SMS_DAILY_PHONE_CAP=10
SMS_DAILY_IP_CAP=30
SMS_MAX_ATTEMPTS=5
# 阿里云号码认证短信服务的赠送签名和赠送模板（需配套使用）
SMS_ALIYUN_ACCESS_KEY_ID=
SMS_ALIYUN_ACCESS_KEY_SECRET=
SMS_ALIYUN_SIGN_NAME=
SMS_ALIYUN_TEMPLATE_CODE=

# ---- 图形验证码（发短信前的人机校验；答案只存哈希，2 分钟有效、错 3 次作废）----
CAPTCHA_TTL_SECONDS=120
CAPTCHA_MAX_ATTEMPTS=3
CAPTCHA_DEV_ECHO=0

# ---- 限流 ----
THROTTLE_UPLOAD_SIGN=30/hour
THROTTLE_TASK_CREATE=60/hour
THROTTLE_WORKER=600/minute
THROTTLE_SMS_SEND=12/hour
THROTTLE_CAPTCHA=60/hour

LOG_LEVEL=INFO

# ---- 微信支付 Native 扫码购买包月会员 ----
# MVP 保持 0；后续版本上线购买功能时再开启。
MEMBERSHIP_PURCHASE_ENABLED=0
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MCH_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=/run/secrets/wechatpay_merchant_private.pem
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_PATH=/run/secrets/wechatpay_public.pem
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=https://你的已备案域名/api/v1/billing/wechat/notify
WECHAT_PAY_MONTHLY_PRICE_FEN=4900
