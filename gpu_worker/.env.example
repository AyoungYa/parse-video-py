# ---------------------------------------------------------------------------
# 无痕匠 · 算力机环境变量
# 这台机器不对外提供服务，只需要能出站访问云端和 OSS。
# ---------------------------------------------------------------------------

DEBUG=0

# ---- 云端地址与身份 ----
CLOUD_BASE_URL=https://wuhenjiang.com
WORKER_ID=pc-01
WORKER_NAME=家里的4090
# 在云端执行 manage.py create_worker 得到，只显示一次
WORKER_TOKEN=

# ---- 与云端对齐的超时参数（和 cloud_web 的 .env 保持一致）----
CLAIM_TIMEOUT=30
HEARTBEAT_INTERVAL=15
LEASE_SECONDS=90
HTTP_TIMEOUT=60

# ---- 本机算力 ----
# Windows + NVIDIA 显卡填 cuda；Mac 填 mps；没有显卡填 cpu（会很慢）
TORCH_DEVICE=cuda
MAX_CONCURRENCY=1
# 家宽上行有限，成片回传并发必须为 1，别调大
UPLOAD_CONCURRENCY=1

# ---- 路径（Windows 用正斜杠，例如 C:/wm/scripts）----
# 修复脚本目录：skill 的 scripts/ 或本仓库的 src/skill/
WM_SCRIPTS_DIR=C:/wm/scripts
# 临时工作区，任务结束自动清理
WORKSPACE_DIR=C:/wm/workspace
# 跑脚本用的解释器（默认与 manage.py 同一个）
# WM_PYTHON=C:/Python311/python.exe

# 水印 mask 扩边像素（与调参台一致）
DEFAULT_PAD=10

WORKER_DB_PATH=worker.sqlite3
LOG_LEVEL=INFO
